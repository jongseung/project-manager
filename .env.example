# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pm_dev"

# Authentication — generate with: openssl rand -base64 32
# WARNING: never ship a default/guessable value to production.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Cron job security — generate with: openssl rand -hex 32
# Used by /api/cron/recurring. If missing, recurring tasks will not trigger.
CRON_SECRET="generate-a-random-secret"

# Environment
NODE_ENV="development"
